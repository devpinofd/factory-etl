# Copiar a prod.tfvars y completar con valores reales.
# NUNCA commitear prod.tfvars al repo.

project_id             = "factory-etl-prod-XXXXXX"
region                 = "us-central1"
environment            = "prod"

# Vistas SQL Mondelez: infraestructura y modelos se habilitan por separado.
enable_sort_dataset   = false

# Inventario de politicas de acceso, sin grants ni acceso al directorio.
enable_sort_access_audit_api = false

# Solo tras desplegar las cuatro vistas autonomas y adoptar las ACL Gold.
enable_sort_consumer_access = false

bronze_bucket_name     = "factory-etl-prod-bronze-XXXXXX"
quarantine_bucket_name = "factory-etl-prod-quarantine-XXXXXX"

control_dataset_id       = "factory_etl_control"
control_dataset_location = "us-central1"
powerbi_group_email      = "bi-analistas@tinitot.com"
cron_schedule             = "30 23 * * *"
cron_schedule_full        = "30 16 * * *"

service_account_name = "factory-etl-runtime"
artifact_repo_id     = "factory-etl-repo"
container_image_name = "factory-etl-extractor"
container_image_tag  = "v1.0.3"

# Workload Identity Federation
wif_enabled         = true
github_owner        = "mi-org"
github_repo         = "bd-sort"
github_allowed_refs = ["refs/heads/main"]

# Retention
bronze_retention_days    = 365
enable_object_versioning = true
