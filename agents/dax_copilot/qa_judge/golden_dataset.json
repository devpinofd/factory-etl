    },
    "criterio": "PercentageRange"
  },
  {
    "id": "TC-009",
    "dominio": "01. Ventas Base",
    "pregunta": "Dame las ventas netas por empresa en el año 2026",
    "dax_esperado": "EVALUATE SUMMARIZECOLUMNS(vw_ventas_bi_consumo[source_empresa], TREATAS({DATE(2026,1,1)}, dim_tiempo[fec_ini]), \"Ventas_Netas\", [Total_Ventas_Netas])",
    "resultado_esperado": {
      "min_filas": 1
    },
    "criterio": "RowCountMinimum"
  },
  {
    "id": "TC-010",
    "dominio": "04. Pareto y Concentración",
    "pregunta": "Muestra el top 5 de productos por ventas netas",
    "dax_esperado": "EVALUATE TOPN(5, SUMMARIZECOLUMNS(vw_ventas_bi_consumo[cod_pro], vw_ventas_bi_consumo[nom_pro], \"Ventas_Netas\", [Total_Ventas_Netas]), [Ventas_Netas], DESC)",
    "resultado_esperado": {
