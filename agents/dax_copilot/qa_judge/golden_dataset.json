[
  {
    "id": "TC-001",
    "dominio": "03. Cartera y Cobertura",
    "pregunta": "¿Cuántos clientes componen la cartera activable a 90 días de Mondelez en julio 2026 para la empresa CTB?",
    "dax_esperado": "EVALUATE SUMMARIZECOLUMNS(vw_ventas_bi_consumo[nom_pro], TREATAS({\"ctb\"}, vw_ventas_bi_consumo[source_empresa]), TREATAS({\"0301\"}, vw_ventas_bi_consumo[cod_pro]), TREATAS({DATE(2026,7,1)}, dim_tiempo[fec_ini]), \"Cartera_90D\", [Cartera_Activable_90D])",
    "resultado_esperado": {
      "columna": "Cartera_90D",
      "valor": 2115,
      "tolerancia": 0
    },
    "criterio": "ExactNumeric"
  },
  {
    "id": "TC-002",
    "dominio": "01. Ventas Base",
    "pregunta": "Dame el total de ventas netas en dólares del mes de julio 2026",
    "dax_esperado": "EVALUATE SUMMARIZECOLUMNS(TREATAS({DATE(2026,7,1)}, dim_tiempo[fec_ini]), \"Ventas_Netas\", [Total_Ventas_Netas])",
    "resultado_esperado": {
      "columna": "Ventas_Netas",
      "condicion": "GreaterThanZero"
    },
    "criterio": "NonZeroNumeric"
  },
  {
    "id": "TC-003",
    "dominio": "02. Venta Cero y Churn",
    "pregunta": "¿Cuántos clientes tienen venta cero en el proveedor Mondelez para CTB en julio?",
    "dax_esperado": "EVALUATE SUMMARIZECOLUMNS(vw_ventas_bi_consumo[nom_pro], TREATAS({\"ctb\"}, vw_ventas_bi_consumo[source_empresa]), TREATAS({\"0301\"}, vw_ventas_bi_consumo[cod_pro]), TREATAS({DATE(2026,7,1)}, dim_tiempo[fec_ini]), \"Venta_Cero\", [Venta_Cero_Clientes])",
    "resultado_esperado": {
      "columna": "Venta_Cero",
      "condicion": "GreaterThanZero"
    },
    "criterio": "NonZeroNumeric"
  },
  {
    "id": "TC-004",
    "dominio": "05. Eficiencia y Ticket",
    "pregunta": "Calcula el ticket promedio de venta por factura en mayo 2026",
    "dax_esperado": "EVALUATE SUMMARIZECOLUMNS(TREATAS({DATE(2026,5,1)}, dim_tiempo[fec_ini]), \"Ticket_Promedio\", [Ticket_Promedio_Venta])",
    "resultado_esperado": {
      "columna": "Ticket_Promedio",
      "condicion": "GreaterThanZero"
    },
    "criterio": "NonZeroNumeric"
  },
  {
    "id": "TC-005",
    "dominio": "06. Georreferenciación",
    "pregunta": "¿Cuál es el porcentaje de clientes geolocalizados con GPS activo en la cartera?",
    "dax_esperado": "EVALUATE ROW(\"Pct_GPS\", [Pct_Cobertura_GPS])",
    "resultado_esperado": {
      "columna": "Pct_GPS",
      "condicion": "Between0And1"
    },
    "criterio": "PercentageRange"
  },
  {
    "id": "TC-006",
    "dominio": "04. Pareto y Concentración",
    "pregunta": "Muestra el top 10 de clientes por volumen de ventas netas en 2026",
    "dax_esperado": "EVALUATE TOPN(10, SUMMARIZECOLUMNS(vw_ventas_bi_consumo[cod_cli], vw_ventas_bi_consumo[nom_cli], \"Total_Ventas\", [Total_Ventas_Netas]), [Total_Ventas], DESC, vw_ventas_bi_consumo[cod_cli], ASC)",
    "resultado_esperado": {
      "min_filas": 10,
      "max_filas": 10
    },
    "criterio": "RowCountExact"
  },
  {
    "id": "TC-007",
    "dominio": "05. Eficiencia y Ticket",
    "pregunta": "¿Cuál es el promedio de SKUs distintos vendidos por factura en junio 2026?",
    "dax_esperado": "EVALUATE SUMMARIZECOLUMNS(TREATAS({DATE(2026,6,1)}, dim_tiempo[fec_ini]), \"SKUs_Factura\", [SKUs_Promedio_Por_Factura])",
    "resultado_esperado": {
      "columna": "SKUs_Factura",
      "condicion": "GreaterThanZero"
    },
    "criterio": "NonZeroNumeric"
  },
  {
    "id": "TC-008",
    "dominio": "03. Cartera y Cobertura",
    "pregunta": "¿Cuál es el porcentaje de activación de clientes de la cartera en el último mes?",
    "dax_esperado": "EVALUATE ROW(\"Pct_Activacion\", [Pct_Activacion])",
