  {
    "id": "TC-011",
    "dominio": "02. Venta Cero y Churn",
    "pregunta": "Calcula cuántos clientes no tuvieron venta en junio 2026",
    "dax_esperado": "EVALUATE SUMMARIZECOLUMNS(TREATAS({DATE(2026,6,1)}, dim_tiempo[fec_ini]), \"Clientes_Venta_Cero\", [Venta_Cero_Clientes])",
    "resultado_esperado": {
      "columna": "Clientes_Venta_Cero",
      "condicion": "GreaterOrEqualZero"
    },
    "criterio": "NonNegativeNumeric"
  },
  {
    "id": "TC-012",
