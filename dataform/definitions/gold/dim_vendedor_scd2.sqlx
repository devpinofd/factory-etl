config {
  type: "table",
  disabled: dataform.projectConfig.vars.enableScd2 != "true",
  schema: "factory_etl_gold",
  name: "dim_vendedor_scd2",
  description: "Dimensión SCD2 de vendedores con vigencias por empresa.",
  bigquery: {
    partitionBy: "DATE(valid_from)",
    clusterBy: ["source_empresa", "cod_ven", "is_current"]
  },
  assertions: {
    uniqueKey: ["surrogate_key"],
    nonNull: ["surrogate_key", "source_empresa", "cod_ven", "valid_from", "record_hash"]
  }
}

SELECT
  s.surrogate_key,
  s.source_empresa,
  s.natural_key AS cod_ven,
  s.valid_from,
  s.valid_to,
  s.is_current,
  s.run_id,
  s.record_hash,
  JSON_VALUE(s.record_json, "$.nom_ven") AS nom_ven,
  JSON_VALUE(s.record_json, "$.status") AS status
FROM ${ref("sil_maestros_scd2")} s
WHERE s.entity_name = "vendedores"
