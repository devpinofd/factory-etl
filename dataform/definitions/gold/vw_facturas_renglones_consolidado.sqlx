config {
  type: "view",
  schema: "factory_etl_gold",
  name: "vw_facturas_renglones_consolidado",
  description: "Consolida ventas de 2025 y 2026 con artículos para derivar unidades, cajas y peso por renglón de factura.",
}

SELECT
  v.source_empresa AS source_empresa,
  v.tipo_documento,
  v.cod_suc,
  v.documento,
  v.renglon,
  v.registro,
  v.cod_ven,
  COALESCE(NULLIF(TRIM(v.nom_ven), ''), ven.nom_ven) AS nom_ven,
  v.cod_cli,
  COALESCE(NULLIF(TRIM(v.nom_cli), ''), cli.nom_cli) AS nom_cli,
  v.nom_cla,
  v.nom_est,
  v.nom_ciu,
  v.cod_art,
  v.cod_alm,
  COALESCE(NULLIF(TRIM(v.cod_mar), ''), art.cod_mar) AS cod_mar,
  COALESCE(NULLIF(TRIM(v.nom_mar), ''), mar.nom_mar) AS nom_mar,
  COALESCE(NULLIF(TRIM(v.nom_dep), ''), dep.nom_dep) AS nom_dep,
  COALESCE(NULLIF(TRIM(v.cod_sec), ''), art.cod_sec) AS cod_sec,
  COALESCE(NULLIF(TRIM(v.modelo), ''), art.modelo) AS modelo,
  v.cod_pro,
  COALESCE(NULLIF(TRIM(v.nom_pro), ''), pro.nom_pro) AS nom_pro,
  COALESCE(NULLIF(TRIM(v.nom_art), ''), art.nom_art) AS nom_art,
  COALESCE(NULLIF(TRIM(v.cod_uni1), ''), art.cod_uni1) AS cod_uni1,

  -- Conversión de unidades a cajas usando la capacidad de bulto del artículo.
  v.can_ven AS unidades_vendidas,
  ROUND(SAFE_DIVIDE(v.can_ven, NULLIF(art.cap_bulto, 0)), 2) AS cajas_vendidas,
  ROUND(v.can_ven * COALESCE(art.peso, 0), 2) AS peso_total_kg,
  ROUND(SAFE_DIVIDE(v.can_ven * COALESCE(art.peso, 0), 1000), 3) AS peso_total_toneladas,

  v.monto_bruto,
  v.cod_mon,
  v.rif,
  v.cod_imp,
  v.neto,
  v.dcto,
  v.tasa,
  v.neto_dcto
FROM ${ref("sil_ventas_diarias")} v
LEFT JOIN ${ref("sil_articulos")} art
  ON v.source_empresa = art.source_empresa AND v.cod_art = art.cod_art
LEFT JOIN ${ref("sil_clientes")} cli
  ON v.source_empresa = cli.source_empresa AND v.cod_cli = cli.cod_cli
LEFT JOIN ${ref("sil_vendedores")} ven
  ON v.source_empresa = ven.source_empresa AND v.cod_ven = ven.cod_ven
LEFT JOIN ${ref("sil_proveedores")} pro
  ON v.source_empresa = pro.source_empresa AND v.cod_pro = pro.cod_pro
LEFT JOIN ${ref("sil_marcas")} mar
  ON v.source_empresa = mar.source_empresa AND COALESCE(NULLIF(TRIM(v.cod_mar), ''), art.cod_mar) = mar.cod_mar
LEFT JOIN ${ref("sil_departamentos")} dep
  ON v.source_empresa = dep.source_empresa AND art.cod_dep = dep.cod_dep
WHERE EXTRACT(YEAR FROM v.registro) IN (2025, 2026)
