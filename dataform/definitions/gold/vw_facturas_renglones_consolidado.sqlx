config {
  type: "view",
  schema: "factory_etl_gold",
  name: "vw_facturas_renglones_consolidado",
  description: "Consolida ventas de 2025 y 2026 con artículos para derivar unidades, cajas y peso por renglón de factura.",
}

SELECT
  v.source_empresa AS source_empresa,
  v.tipo_documento,
  v.cod_suc,
  v.documento,
  v.renglon,
  v.registro,
  v.cod_ven,
  v.nom_ven,
  v.cod_cli,
  v.nom_cli,
  v.nom_cla,
  v.nom_est,
  v.nom_ciu,
  v.cod_art,
  v.cod_alm,
  v.cod_mar,
  v.nom_mar,
  v.nom_dep,
  v.cod_sec,
  v.modelo,
  v.cod_pro,
  v.nom_pro,
  v.nom_art,
  v.cod_uni1,

  -- Conversión de unidades a cajas usando la capacidad de bulto del artículo.
  v.can_ven AS unidades_vendidas,
  ROUND(SAFE_DIVIDE(v.can_ven, NULLIF(art.cap_bulto, 0)), 2) AS cajas_vendidas,
  ROUND(v.can_ven * COALESCE(art.peso, 0), 2) AS peso_total_kg,
  ROUND(SAFE_DIVIDE(v.can_ven * COALESCE(art.peso, 0), 1000), 3) AS peso_total_toneladas,

  v.monto_bruto,
  v.cod_mon,
  v.rif,
  v.cod_imp,
  v.neto,
  v.dcto,
  v.tasa,
  v.neto_dcto
FROM ${ref("sil_ventas_diarias")} v
LEFT JOIN ${ref("sil_articulos")} art
  ON v.source_empresa = art.source_empresa AND v.cod_art = art.cod_art
WHERE EXTRACT(YEAR FROM v.registro) IN (2025, 2026)
