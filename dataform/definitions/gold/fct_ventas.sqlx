config {
  type: "table",
  schema: "factory_etl_gold",
  name: "fct_ventas",
  description: "Tabla de Hechos Gold de Ventas consolidadas por transacción, renglón, empresa, sucursal, vendedor y producto",
  bigquery: {
    partitionBy: "DATE(registro)",
    clusterBy: ["source_empresa", "cod_suc", "cod_pro", "cod_ven"]
  }
}

SELECT
  v.source_empresa AS source_empresa,
  COALESCE(emp.nombre_empresa, v.source_empresa) AS nombre_empresa,
  emp.razon_social AS razon_social_empresa,
  v.tipo_documento,
  v.cod_suc,
  v.documento,
  v.renglon,
  v.registro,
  t.fecha AS fecha_registro,
  t.fecha_key,
  t.anio,
  t.mes,
  t.nombre_mes,
  t.anio_mes,
  t.trimestre,
  t.trimestre_nombre,
  t.anio_trimestre,
  t.semana_del_anio,
  t.anio_semana,
  t.quincena,
  t.quincena_nombre,
  v.cod_ven,
  v.nom_ven,
  v.cod_cli,
  v.nom_cli,
  v.nom_cla,
  v.nom_est,
  v.nom_ciu,
  v.cod_art,
  v.cod_mar,
  v.nom_mar,
  v.nom_dep,
  v.cod_sec,
  v.modelo,
  v.cod_pro,
  v.nom_pro,
  v.nom_art,
  v.cod_uni1,
  v.unidades_vendidas,
  v.cajas_vendidas,
  v.peso_total_kg,
  v.peso_total_toneladas,
  v.volumen_total_m3,
  v.monto_bruto,
  v.cod_mon,
  v.rif,
  v.cod_imp,
  v.neto,
  v.dcto,
  v.tasa,
  v.neto_dcto
FROM ${ref("vw_facturas_renglones_consolidado")} v
LEFT JOIN ${ref("dim_empresa")} emp
  ON v.source_empresa = emp.source_empresa
INNER JOIN ${ref("dim_tiempo")} t
  ON DATE(v.registro) = t.fecha
