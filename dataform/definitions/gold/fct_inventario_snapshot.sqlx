config {
  type: "table",
  schema: "factory_etl_gold",
  name: "fct_inventario_snapshot",
  description: "Hecho de snapshot periódico de inventario por empresa, fecha, almacén y artículo, compatible con el modelo Gold legacy.",
  bigquery: {
    partitionBy: "snapshot_date",
    clusterBy: ["source_empresa", "cod_alm", "cod_art"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "snapshot_date", "cod_alm", "cod_art"],
    nonNull: ["source_empresa", "snapshot_date", "cod_alm", "cod_art", "unidades_disponibles"]
  }
}

SELECT
  h.source_empresa,
  h.snapshot_date,
  h.run_id,
  h.cod_alm,
  h.cod_art,
  h.exi_act1 AS unidades_disponibles,
  h.registro,
  CURRENT_TIMESTAMP() AS _processed_at
FROM ${ref("sil_renglones_almacenes_historico")} h
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY h.source_empresa, h.snapshot_date, h.cod_alm, h.cod_art
  ORDER BY COALESCE(h._ingested_at, h.registro, h._processed_at) DESC, h.run_id DESC
) = 1
