config {
  type: "table",
  schema: "factory_etl_gold",
  name: "fct_inventario_snapshot",
  description: "Ultima captura completa por empresa y dia Venezuela. Snapshot diario sin mezclar ejecuciones; atributos descriptivos en los maestros actuales.",
  bigquery: {
    partitionBy: "snapshot_date",
    clusterBy: ["source_empresa", "cod_alm", "cod_art"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "snapshot_date", "cod_alm", "cod_art"],
    nonNull: ["source_empresa", "snapshot_date", "run_id", "cod_alm", "cod_art", "unidades_disponibles", "registro", "_ingested_at"],
    rowConditions: ["snapshot_date = DATE(_ingested_at, 'America/Caracas')"]
  }
}

WITH ganadoras AS (
  SELECT *
  FROM ${ref("vw_inventario_capturas_qa")}
  WHERE estado = 'COMPLETA'
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY source_empresa, dia_venezuela
    ORDER BY captura DESC, run_id DESC
  ) = 1
)
SELECT
  h.source_empresa,
  g.dia_venezuela AS snapshot_date,
  h.run_id,
  h.cod_alm,
  h.cod_art,
  h.exi_act1 AS unidades_disponibles,
  h.registro,
  h._ingested_at,
  CURRENT_TIMESTAMP() AS _processed_at
FROM ${ref("sil_renglones_almacenes_historico")} h
JOIN ganadoras g
  ON h.source_empresa = g.source_empresa AND h.run_id = g.run_id
