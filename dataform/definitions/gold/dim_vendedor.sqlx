config {
  type: "table",
  schema: "factory_etl_gold",
  name: "dim_vendedor",
  description: "Dimensión Gold de vendedores (pass-through de sil_vendedores)",
  bigquery: {
    clusterBy: ["source_empresa", "cod_ven"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_ven"],
    nonNull: ["source_empresa", "cod_ven"]
  }
}

SELECT * FROM ${ref("sil_vendedores")}
