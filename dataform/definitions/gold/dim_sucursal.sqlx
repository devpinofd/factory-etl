config {
  type: "table",
  schema: "factory_etl_gold",
  name: "dim_sucursal",
  description: "Dimensión Gold de sucursales (pass-through de sil_sucursales)",
  bigquery: {
    clusterBy: ["source_empresa", "cod_suc"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_suc"],
    nonNull: ["source_empresa", "cod_suc"]
  }
}

SELECT * FROM ${ref("sil_sucursales")}
