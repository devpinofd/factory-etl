config {
  type: "incremental",
  schema: "factory_etl_security",
  name: "fact_facturas_renglones_powerbi",
  description: "Tabla Gold optimizada para Power BI. Conserva el detalle de facturas de 2026, particionado por fecha y clusterizado para reducir bytes procesados.",
  uniqueKey: ["source_empresa", "tipo_documento", "cod_suc", "documento", "renglon"],
  bigquery: {
    partitionBy: "fecha_registro",
    clusterBy: ["source_empresa", "cod_art", "cod_cli", "cod_ven"]
  }
}

SELECT
  v._source_empresa AS source_empresa,
  v.fecha_registro,
  v.tipo_documento,
  v.cod_suc,
  v.documento,
  v.renglon,
  v.registro,
  v.cod_ven,
  v.nom_ven,
  v.cod_cli,
  v.nom_cli,
  v.nom_cla,
  
  -- 📍 ENRIQUECIMIENTO GEOGRÁFICO DE CIUDAD, ESTADO Y MUNICIPIO
  COALESCE(NULLIF(TRIM(cli.cod_ciu), ''), 'SIN_CIU') AS cod_ciu,
  COALESCE(NULLIF(TRIM(ciu.nom_ciu), ''), NULLIF(TRIM(cli.nom_mun), ''), NULLIF(TRIM(v.nom_ciu), ''), 'SIN CIUDAD') AS nom_ciu,
  COALESCE(NULLIF(TRIM(cli.cod_est), ''), NULLIF(TRIM(v.nom_est), ''), 'SIN ESTADO') AS nom_est,
  cli.nom_mun,
  cli.latitud,
  cli.longitud,

  v.cod_art,
  v.cod_mar,
  v.nom_mar,
  v.nom_dep,
  v.cod_sec,
  v.modelo,
  v.cod_pro,
  v.nom_pro,
  v.nom_art,
  v.cod_uni1,
  v.can_ven AS unidades_vendidas,
  SAFE_DIVIDE(v.can_ven, NULLIF(COALESCE(art.cap_bulto, art.fraccion), 0)) AS cajas_vendidas,
  v.can_ven * COALESCE(art.peso, 0) AS peso_total_kg,
  SAFE_DIVIDE(v.can_ven * COALESCE(art.peso, 0), 1000) AS peso_total_toneladas,
  v.monto_bruto,
  v.cod_mon,
  v.rif,
  v.cod_imp,
  v.neto,
  v.dcto,
  v.tasa,
  v.neto_dcto
FROM ${ref("sil_ventas_diarias")} v
LEFT JOIN ${ref("sil_clientes")} cli
  ON v._source_empresa = cli._source_empresa
  AND v.cod_cli = cli.cod_cli
LEFT JOIN ${ref("sil_ciudades")} ciu
  ON cli._source_empresa = ciu._source_empresa
  AND cli.cod_ciu = ciu.cod_ciu
LEFT JOIN ${ref("sil_articulos")} art
  ON v._source_empresa = art._source_empresa
  AND v.cod_art = art.cod_art
WHERE v.fecha_registro >= DATE '2026-01-01'
  AND v.fecha_registro < DATE '2027-01-01'
  ${when(incremental(), "AND v.fecha_registro >= DATE_SUB(CURRENT_DATE('America/Caracas'), INTERVAL 3 DAY)", "")}
