config {
  type: "table",
  schema: "factory_etl_gold",
  name: "dim_cliente",
  description: "Dimensión de cliente en Gold con latitud, longitud y RIF",
  bigquery: {
    clusterBy: ["_source_empresa", "cod_cli"]
  },
  assertions: {
    uniqueKey: ["_source_empresa", "cod_cli"],
    nonNull: ["_source_empresa", "cod_cli"]
  }
}

SELECT * FROM ${ref("sil_clientes")}
