config {
  type: "table",
  schema: "factory_etl_gold",
  name: "dim_cliente",
  description: "Dimensión de cliente en Gold con latitud, longitud, RIF y nombre de clase de cliente (nom_cla)",
  bigquery: {
    clusterBy: ["source_empresa", "cod_cli"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_cli"],
    nonNull: ["source_empresa", "cod_cli"]
  }
}

SELECT
  c.* REPLACE (
    CAST(c.gps AS STRING) AS gps,
    COALESCE(NULLIF(TRIM(c.segmentacion2), ''), 'SIN CLASIFICAR') AS segmentacion2
  ),
  c.segmentacion1 AS cod_cla,
  COALESCE(cla.nom_cla, 'SIN CLASIFICAR') AS nom_cla
FROM ${ref("sil_clientes")} c
LEFT JOIN (
  SELECT source_empresa, cod_cla, ANY_VALUE(nom_cla) AS nom_cla
  FROM ${ref("sil_clases_clientes")}
  GROUP BY source_empresa, cod_cla
) cla
  ON c.source_empresa = cla.source_empresa
 AND c.segmentacion1 = cla.cod_cla


