config {
  type: "table",
  schema: "factory_etl_gold",
  name: "dim_marca",
  description: "Dimensión Gold de marcas (pass-through de sil_marcas)",
  bigquery: {
    clusterBy: ["_source_empresa", "cod_mar"]
  },
  assertions: {
    uniqueKey: ["_source_empresa", "cod_mar"],
    nonNull: ["_source_empresa", "cod_mar"]
  }
}

SELECT * FROM ${ref("sil_marcas")}
