config {
  type: "table",
  disabled: dataform.projectConfig.vars.enableScd2 != "true",
  schema: "factory_etl_gold",
  name: "fct_ventas_v2",
  description: "Hecho transaccional de ventas por línea de factura con claves sustitutas SCD2 y dimensiones degeneradas de documento y renglón.",
  bigquery: {
    partitionBy: "DATE(registro)",
    clusterBy: ["source_empresa", "cliente_sk", "articulo_sk", "sucursal_sk"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "tipo_documento", "cod_suc", "documento", "renglon"],
    nonNull: ["source_empresa", "tipo_documento", "documento", "renglon", "cliente_sk", "articulo_sk", "registro"]
  }
}

WITH sales AS (
  SELECT *
  FROM ${ref("vw_facturas_renglones_consolidado")}
),
resolved AS (
  SELECT
    v.*,
    c.surrogate_key AS cliente_sk,
    ar.surrogate_key AS articulo_sk,
    ve.surrogate_key AS vendedor_sk,
    su.surrogate_key AS sucursal_sk,
    al.surrogate_key AS almacen_sk,
    p.surrogate_key AS proveedor_sk,
    c_current.surrogate_key AS cliente_current_sk,
    ar_current.surrogate_key AS articulo_current_sk,
    ve_current.surrogate_key AS vendedor_current_sk,
    su_current.surrogate_key AS sucursal_current_sk,
    al_current.surrogate_key AS almacen_current_sk,
    al_current.nom_alm AS current_nom_alm,
    p_current.surrogate_key AS proveedor_current_sk,
    c_current.nom_cli AS current_nom_cli,
    ar_current.nom_art AS current_nom_art,
    ve_current.nom_ven AS current_nom_ven,
    p_current.nom_pro AS current_nom_pro,
    c_current.rif AS current_rif
  FROM sales v
  LEFT JOIN ${ref("dim_cliente_scd2")} c
    ON c.source_empresa = v.source_empresa
   AND c.cod_cli = v.cod_cli
   AND c.valid_from <= v.registro
   AND (c.valid_to IS NULL OR c.valid_to > v.registro)
  LEFT JOIN ${ref("dim_articulo_scd2")} ar
    ON ar.source_empresa = v.source_empresa
   AND ar.cod_art = v.cod_art
   AND ar.valid_from <= v.registro
   AND (ar.valid_to IS NULL OR ar.valid_to > v.registro)
  LEFT JOIN ${ref("dim_vendedor_scd2")} ve
    ON ve.source_empresa = v.source_empresa
   AND ve.cod_ven = v.cod_ven
   AND ve.valid_from <= v.registro
   AND (ve.valid_to IS NULL OR ve.valid_to > v.registro)
  LEFT JOIN ${ref("dim_sucursal_scd2")} su
    ON su.source_empresa = v.source_empresa
   AND su.cod_suc = v.cod_suc
   AND su.valid_from <= v.registro
   AND (su.valid_to IS NULL OR su.valid_to > v.registro)
  LEFT JOIN ${ref("dim_almacen_scd2")} al
    ON al.source_empresa = v.source_empresa
   AND al.cod_alm = v.cod_alm
   AND al.valid_from <= v.registro
   AND (al.valid_to IS NULL OR al.valid_to > v.registro)
  LEFT JOIN ${ref("dim_proveedor_scd2")} p
    ON p.source_empresa = v.source_empresa
   AND p.cod_pro = v.cod_pro
   AND p.valid_from <= v.registro
   AND (p.valid_to IS NULL OR p.valid_to > v.registro)
  LEFT JOIN ${ref("dim_cliente_scd2")} c_current
    ON c_current.source_empresa = v.source_empresa
   AND c_current.cod_cli = v.cod_cli
   AND c_current.is_current
  LEFT JOIN ${ref("dim_articulo_scd2")} ar_current
    ON ar_current.source_empresa = v.source_empresa
   AND ar_current.cod_art = v.cod_art
   AND ar_current.is_current
  LEFT JOIN ${ref("dim_vendedor_scd2")} ve_current
    ON ve_current.source_empresa = v.source_empresa
   AND ve_current.cod_ven = v.cod_ven
   AND ve_current.is_current
  LEFT JOIN ${ref("dim_sucursal_scd2")} su_current
    ON su_current.source_empresa = v.source_empresa
   AND su_current.cod_suc = v.cod_suc
   AND su_current.is_current
  LEFT JOIN ${ref("dim_almacen_scd2")} al_current
    ON al_current.source_empresa = v.source_empresa
   AND al_current.cod_alm = v.cod_alm
   AND al_current.is_current
  LEFT JOIN ${ref("dim_proveedor_scd2")} p_current
    ON p_current.source_empresa = v.source_empresa
   AND p_current.cod_pro = v.cod_pro
   AND p_current.is_current
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY v.source_empresa, v.tipo_documento, v.cod_suc, v.documento, v.renglon
    ORDER BY c.valid_from DESC, ar.valid_from DESC
  ) = 1
)
SELECT
  source_empresa,
  tipo_documento,
  cod_suc,
  documento,
  renglon,
  registro,
  cod_alm,
  cod_ven,
  cod_cli,
  cod_art,
  cod_mar,
  cod_sec,
  modelo,
  cod_pro,
  cod_uni1,
  nom_cla,
  nom_est,
  nom_ciu,
  COALESCE(cliente_sk, cliente_current_sk, "UNKNOWN") AS cliente_sk,
  COALESCE(articulo_sk, articulo_current_sk, "UNKNOWN") AS articulo_sk,
  COALESCE(vendedor_sk, vendedor_current_sk, "UNKNOWN") AS vendedor_sk,
  COALESCE(sucursal_sk, sucursal_current_sk, "UNKNOWN") AS sucursal_sk,
  COALESCE(almacen_sk, almacen_current_sk, "UNKNOWN") AS almacen_sk,
  COALESCE(proveedor_sk, proveedor_current_sk, "UNKNOWN") AS proveedor_sk,
  CASE WHEN cliente_sk IS NOT NULL THEN "RESOLVED_SCD2" WHEN cliente_current_sk IS NOT NULL THEN "CURRENT_MASTER_BACKFILL" ELSE "UNKNOWN_UNRESOLVED" END AS cliente_resolution_status,
  CASE WHEN articulo_sk IS NOT NULL THEN "RESOLVED_SCD2" WHEN articulo_current_sk IS NOT NULL THEN "CURRENT_MASTER_BACKFILL" ELSE "UNKNOWN_UNRESOLVED" END AS articulo_resolution_status,
  CASE WHEN vendedor_sk IS NOT NULL THEN "RESOLVED_SCD2" WHEN vendedor_current_sk IS NOT NULL THEN "CURRENT_MASTER_BACKFILL" ELSE "UNKNOWN_UNRESOLVED" END AS vendedor_resolution_status,
  CASE WHEN sucursal_sk IS NOT NULL THEN "RESOLVED_SCD2" WHEN sucursal_current_sk IS NOT NULL THEN "CURRENT_MASTER_BACKFILL" ELSE "UNKNOWN_UNRESOLVED" END AS sucursal_resolution_status,
  CASE WHEN almacen_sk IS NOT NULL THEN "RESOLVED_SCD2" WHEN almacen_current_sk IS NOT NULL THEN "CURRENT_MASTER_BACKFILL" ELSE "UNKNOWN_UNRESOLVED" END AS almacen_resolution_status,
  CASE WHEN proveedor_sk IS NOT NULL THEN "RESOLVED_SCD2" WHEN proveedor_current_sk IS NOT NULL THEN "CURRENT_MASTER_BACKFILL" ELSE "UNKNOWN_UNRESOLVED" END AS proveedor_resolution_status,
  COALESCE(nom_cli, current_nom_cli) AS source_nom_cli,
  COALESCE(nom_art, current_nom_art) AS source_nom_art,
  COALESCE(nom_ven, current_nom_ven) AS source_nom_ven,
  current_nom_alm AS source_nom_alm,
  nom_mar AS source_nom_mar,
  nom_dep AS source_nom_dep,
  cod_sec AS source_cod_sec,
  cod_suc AS source_cod_suc,
  COALESCE(nom_pro, current_nom_pro) AS source_nom_pro,
  COALESCE(rif, current_rif) AS source_rif,
  COALESCE(nom_ven, current_nom_ven) AS nom_ven,
  COALESCE(nom_cli, current_nom_cli) AS nom_cli,
  nom_mar,
  nom_dep,
  COALESCE(nom_pro, current_nom_pro) AS nom_pro,
  COALESCE(nom_art, current_nom_art) AS nom_art,
  (
    cliente_sk IS NULL
    OR articulo_sk IS NULL
    OR vendedor_sk IS NULL
    OR sucursal_sk IS NULL
    OR almacen_sk IS NULL
    OR proveedor_sk IS NULL
  ) AS is_inferred,
  CASE
    WHEN cliente_sk IS NULL
      AND cliente_current_sk IS NOT NULL
      OR articulo_sk IS NULL
      AND articulo_current_sk IS NOT NULL
      OR vendedor_sk IS NULL
      AND vendedor_current_sk IS NOT NULL
      OR sucursal_sk IS NULL
      AND sucursal_current_sk IS NOT NULL
      OR almacen_sk IS NULL
      AND almacen_current_sk IS NOT NULL
      OR proveedor_sk IS NULL
      AND proveedor_current_sk IS NOT NULL
    THEN "CURRENT_MASTER_BACKFILL"
    WHEN cliente_sk IS NULL
      OR articulo_sk IS NULL
      OR vendedor_sk IS NULL
      OR sucursal_sk IS NULL
      OR almacen_sk IS NULL
      OR proveedor_sk IS NULL
    THEN "INFERRED_FROM_FACT"
    ELSE "RESOLVED_SCD2"
  END AS resolution_status,
  cod_mon,
  cod_imp,
  unidades_vendidas,
  cajas_vendidas,
  peso_total_kg,
  peso_total_toneladas,
  monto_bruto,
  neto,
  dcto,
  tasa,
  neto_dcto,
  rif
FROM resolved
