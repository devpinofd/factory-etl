config {
  type: "table",
  schema: "factory_etl_gold",
  name: "dim_almacen",
  description: "Dimensión Gold de almacenes (pass-through de sil_almacenes)",
  bigquery: {
    clusterBy: ["source_empresa", "cod_alm"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_alm"],
    nonNull: ["source_empresa", "cod_alm"]
  }
}

SELECT * FROM ${ref("sil_almacenes")}
