config {
  type: "table",
  schema: "factory_etl_gold",
  name: "fct_ventas_bi",
  description: "Tabla física semántica para Power BI, limitada a ventas 2025-2026 y optimizada para filtros por empresa, sucursal y vendedor.",
  bigquery: {
    partitionBy: "DATE(registro)",
    clusterBy: ["source_empresa", "cod_suc", "cod_ven"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "tipo_documento", "cod_suc", "documento", "renglon"],
    nonNull: ["source_empresa", "tipo_documento", "cod_suc", "documento", "renglon", "registro"]
  }
}

SELECT
  v.source_empresa,
  v.tipo_documento,
  v.cod_suc,
  v.documento,
  v.renglon,
  v.registro,
  v.cod_ven,
  ven.nom_ven,
  v.cod_cli,
  cli.nom_cli,
  cli.rif,
  CAST(NULL AS STRING) AS nom_cla,
  CAST(NULL AS STRING) AS nom_est,
  CAST(NULL AS STRING) AS nom_ciu,
  v.cod_art,
  art.nom_art,
  v.cod_alm,
  art.cod_mar,
  mar.nom_mar,
  art.cod_dep,
  dep.nom_dep,
  art.cod_sec,
  art.modelo,
  v.cod_pro,
  pro.nom_pro,
  art.cod_uni1,
  v.cod_mon,
  v.cod_imp,
  v.unidades_vendidas,
  v.monto_bruto,
  v.neto,
  v.dcto,
  v.tasa,
  v.neto_dcto,
  ROUND(SAFE_DIVIDE(v.unidades_vendidas, NULLIF(art.cap_bulto, 0)), 2) AS cajas_vendidas,
  ROUND(v.unidades_vendidas * COALESCE(art.peso, 0), 2) AS peso_total_kg,
  ROUND(SAFE_DIVIDE(v.unidades_vendidas * COALESCE(art.peso, 0), 1000), 3) AS peso_total_toneladas
FROM ${ref("fct_ventas_gold")} v
LEFT JOIN ${ref("sil_clientes")} cli
  ON v.source_empresa = cli.source_empresa AND v.cod_cli = cli.cod_cli
LEFT JOIN ${ref("sil_vendedores")} ven
  ON v.source_empresa = ven.source_empresa AND v.cod_ven = ven.cod_ven
LEFT JOIN ${ref("sil_articulos")} art
  ON v.source_empresa = art.source_empresa AND v.cod_art = art.cod_art
LEFT JOIN ${ref("sil_marcas")} mar
  ON v.source_empresa = mar.source_empresa AND art.cod_mar = mar.cod_mar
LEFT JOIN ${ref("sil_departamentos")} dep
  ON v.source_empresa = dep.source_empresa AND art.cod_dep = dep.cod_dep
LEFT JOIN ${ref("sil_proveedores")} pro
  ON v.source_empresa = pro.source_empresa AND v.cod_pro = pro.cod_pro
WHERE DATE(v.registro) >= DATE '2025-01-01'
  AND DATE(v.registro) <= CURRENT_DATE()
