config {
  type: "table",
  schema: "factory_etl_gold",
  name: "dim_seccion",
  description: "Dimensión Gold de secciones (pass-through de sil_secciones)",
  bigquery: {
    clusterBy: ["source_empresa", "cod_sec"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_sec"],
    nonNull: ["source_empresa", "cod_sec"]
  }
}

SELECT * FROM ${ref("sil_secciones")}
