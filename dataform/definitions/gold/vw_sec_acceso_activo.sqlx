config {
  type: "view",
  schema: "factory_etl_gold",
  name: "vw_sec_acceso_activo",
  description: "Vista de consumo de gobernanza: expone solo registros activos y vigentes para Power BI / Looker Studio"
}

SELECT
  access_id,
  access_hash,
  user_email,
  provider_id,
  source_empresa,
  cod_suc,
  role_type,
  access_level,
  platform_scope,
  effective_from,
  granted_by
FROM ${ref("sec_acceso_proveedores")}
WHERE is_current = TRUE
  AND access_status = 'ACTIVE'
  AND effective_from <= CURRENT_TIMESTAMP()
  AND effective_to > CURRENT_TIMESTAMP()
