config {
  type: "view",
  disabled: dataform.projectConfig.vars.enableScd2 != "true",
  schema: "factory_etl_gold",
  name: "vw_ventas_bi_consumo",
  description: "Vista de consumo BI de ventas 2025-2026. Expone sólo dimensiones de negocio, fechas y medidas; excluye claves técnicas, hashes y metadatos de reconciliación.",
}

SELECT
  source_empresa,
  tipo_documento,
  cod_suc,
  documento,
  renglon,
  registro,
  cod_ven,
  nom_ven,
  cod_cli,
  nom_cli,
  nom_cla,
  nom_est,
  nom_ciu,
  cod_art,
  cod_alm,
  cod_mar,
  nom_mar,
  nom_dep,
  cod_sec,
  modelo,
  cod_pro,
  nom_pro,
  nom_art,
  cod_uni1,
  unidades_vendidas,
  cajas_vendidas,
  peso_total_kg,
  peso_total_toneladas,
  monto_bruto,
  cod_mon,
  rif,
  cod_imp,
  neto,
  dcto,
  tasa,
  neto_dcto
FROM ${ref("vw_ventas_reconciliadas")}
