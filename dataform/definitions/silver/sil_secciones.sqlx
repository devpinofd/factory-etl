config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_secciones",
  description: "Tabla Silver de secciones (limpia, tipada y deduplicada) generada desde stg_secciones",
  bigquery: {
    clusterBy: ["source_empresa"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_sec"],
    nonNull: ["source_empresa", "cod_sec"]
  }
}

SELECT
  source_empresa,
  ${helpers.trimStr("cod_sec")} AS cod_sec,
  ${helpers.trimStr("nom_sec")} AS nom_sec,
  ${helpers.trimStr("status")} AS status,
  _ingested_at
FROM ${ref("stg_secciones_snapshot")}
-- 🔒 Filtro de calidad: excluye filas que no cumplen campos requeridos (ver sil_*_rechazados)
WHERE
  (cod_sec IS NOT NULL AND TRIM(CAST(cod_sec AS STRING)) != '')
  AND (nom_sec IS NOT NULL AND TRIM(CAST(nom_sec AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY source_empresa, cod_sec
  ORDER BY _ingested_at DESC
) = 1
