config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_clases_clientes_rechazados",
  description: "Filas de stg_clases_clientes que no cumplen validacion de campos requeridos (cod_cla, nom_cla, status); cuarentena de calidad de datos en Silver",
  bigquery: {
    clusterBy: ["source_empresa"]
  }
}

SELECT
  *,
  CURRENT_TIMESTAMP() AS _rechazado_en,
(
    SELECT STRING_AGG(motivo, ', ')
    FROM UNNEST([
      IF((cod_cla IS NULL OR TRIM(CAST(cod_cla AS STRING)) = ''), 'cod_cla', NULL),
      IF((nom_cla IS NULL OR TRIM(CAST(nom_cla AS STRING)) = ''), 'nom_cla', NULL),
      IF((status IS NULL OR TRIM(CAST(status AS STRING)) = ''), 'status', NULL)
    ]) AS motivo
  ) AS motivo_rechazo
FROM ${ref("stg_clases_clientes_snapshot")}
WHERE NOT (
  (cod_cla IS NOT NULL AND TRIM(CAST(cod_cla AS STRING)) != '')
  AND (nom_cla IS NOT NULL AND TRIM(CAST(nom_cla AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')
)
