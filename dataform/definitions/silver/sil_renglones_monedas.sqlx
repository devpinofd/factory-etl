config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_renglones_monedas",
  description: "Tabla Silver de tasas de cambio de monedas (limpia y deduplicada)",
  bigquery: {
    partitionBy: "DATE(registro)",
    clusterBy: ["source_empresa", "cod_mon"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_mon", "renglon", "registro"],
    nonNull: ["source_empresa", "cod_mon", "renglon", "registro"]
  }
}

SELECT
  source_empresa,
  ${helpers.trimStr("cod_mon")} AS cod_mon,
  SAFE_CAST(renglon AS INT64) AS renglon,
  ${helpers.toTimestamp("fecha")} AS fecha,
  ${helpers.toNumeric("tasa")} AS tasa,
  ${helpers.trimStr("comentario")} AS comentario,
  ${helpers.toTimestamp("registro")} AS registro,
  DATE(${helpers.toTimestamp("registro")}) AS fecha_registro,
  _ingested_at
FROM ${ref("stg_renglones_monedas_snapshot")}
-- 🔒 Filtro de calidad: excluye filas que no cumplen campos requeridos (ver sil_*_rechazados)
WHERE
  (cod_mon IS NOT NULL AND TRIM(CAST(cod_mon AS STRING)) != '')
  AND renglon IS NOT NULL

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY source_empresa, cod_mon, renglon, registro
  ORDER BY _ingested_at DESC
) = 1
