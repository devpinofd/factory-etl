config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_estados",
  description: "Tabla Silver de estados (limpia, tipada y deduplicada) generada desde stg_estados",
  bigquery: {
    clusterBy: ["_source_empresa", "cod_est"]
  },
  assertions: {
    uniqueKey: ["_source_empresa", "cod_est"],
    nonNull: ["_source_empresa", "cod_est"]
  }
}

SELECT
  _source_empresa,
  ${helpers.trimStr("cod_est")} AS cod_est,
  ${helpers.trimStr("nom_est")} AS nom_est,
  ${helpers.trimStr("status")} AS status,
  _ingested_at
FROM ${ref("stg_estados")}
-- 🔒 Filtro de calidad: excluye filas que no cumplen campos requeridos (ver sil_*_rechazados)
WHERE
  (cod_est IS NOT NULL AND TRIM(CAST(cod_est AS STRING)) != '')
  AND (nom_est IS NOT NULL AND TRIM(CAST(nom_est AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY _source_empresa, cod_est
  ORDER BY _ingested_at DESC
) = 1
