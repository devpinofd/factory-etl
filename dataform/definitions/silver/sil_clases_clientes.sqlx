config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_clases_clientes",
  description: "Tabla Silver de clases_clientes (limpia, tipada y deduplicada) generada desde stg_clases_clientes",
  bigquery: {
    clusterBy: ["_source_empresa", "cod_cla"]
  },
  assertions: {
    uniqueKey: ["_source_empresa", "cod_cla"],
    nonNull: ["_source_empresa", "cod_cla"]
  }
}

SELECT
  _source_empresa,
  ${helpers.trimStr("cod_cla")} AS cod_cla,
  ${helpers.trimStr("nom_cla")} AS nom_cla,
  ${helpers.trimStr("status")} AS status,
  _ingested_at
FROM ${ref("stg_clases_clientes")}
-- 🔒 Filtro de calidad: excluye filas que no cumplen campos requeridos (ver sil_*_rechazados)
WHERE
  (cod_cla IS NOT NULL AND TRIM(CAST(cod_cla AS STRING)) != '')
  AND (nom_cla IS NOT NULL AND TRIM(CAST(nom_cla AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY _source_empresa, cod_cla
  ORDER BY _ingested_at DESC
) = 1
