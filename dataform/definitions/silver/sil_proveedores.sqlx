config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_proveedores",
  description: "Tabla Silver de proveedores (limpia, tipada y deduplicada) generada desde stg_proveedores",
  bigquery: {
    clusterBy: ["source_empresa"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_pro"],
    nonNull: ["source_empresa", "cod_pro"]
  }
}

SELECT
  source_empresa,
  ${helpers.trimStr("cod_pro")} AS cod_pro,
  ${helpers.trimStr("nom_pro")} AS nom_pro,
  ${helpers.trimStr("rif")} AS rif,
  ${helpers.trimStr("dir_fis")} AS dir_fis,
  ${helpers.trimStr("status")} AS status,
  _ingested_at
FROM ${ref("stg_proveedores_snapshot")}
-- 🔒 Filtro de calidad: excluye filas que no cumplen campos requeridos (ver sil_*_rechazados)
WHERE
  (cod_pro IS NOT NULL AND TRIM(CAST(cod_pro AS STRING)) != '')
  AND (nom_pro IS NOT NULL AND TRIM(CAST(nom_pro AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY source_empresa, cod_pro
  ORDER BY _ingested_at DESC
) = 1
