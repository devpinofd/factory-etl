config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_ciudades",
  description: "Tabla Silver de ciudades (limpia, tipada y deduplicada) generada desde stg_ciudades",
  bigquery: {
    clusterBy: ["_source_empresa", "cod_ciu"]
  },
  assertions: {
    uniqueKey: ["_source_empresa", "cod_ciu"],
    nonNull: ["_source_empresa", "cod_ciu"]
  }
}

SELECT
  _source_empresa,
  ${helpers.trimStr("cod_ciu")} AS cod_ciu,
  ${helpers.trimStr("nom_ciu")} AS nom_ciu,
  ${helpers.trimStr("status")} AS status,
  _ingested_at
FROM ${ref("stg_ciudades")}
-- 🔒 Filtro de calidad: excluye filas que no cumplen campos requeridos (ver sil_*_rechazados)
WHERE
  (cod_ciu IS NOT NULL AND TRIM(CAST(cod_ciu AS STRING)) != '')
  AND (nom_ciu IS NOT NULL AND TRIM(CAST(nom_ciu AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY _source_empresa, cod_ciu
  ORDER BY _ingested_at DESC
) = 1
