config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_secciones_rechazados",
  description: "Filas de stg_secciones que no cumplen validacion de campos requeridos (cod_sec, nom_sec, status); cuarentena de calidad de datos en Silver",
  bigquery: {
    clusterBy: ["source_empresa"]
  }
}

SELECT
  *,
  CURRENT_TIMESTAMP() AS _rechazado_en,
(
    SELECT STRING_AGG(motivo, ', ')
    FROM UNNEST([
      IF((cod_sec IS NULL OR TRIM(CAST(cod_sec AS STRING)) = ''), 'cod_sec', NULL),
      IF((nom_sec IS NULL OR TRIM(CAST(nom_sec AS STRING)) = ''), 'nom_sec', NULL),
      IF((status IS NULL OR TRIM(CAST(status AS STRING)) = ''), 'status', NULL)
    ]) AS motivo
  ) AS motivo_rechazo
FROM ${ref("stg_secciones_snapshot")}
WHERE NOT (
  (cod_sec IS NOT NULL AND TRIM(CAST(cod_sec AS STRING)) != '')
  AND (nom_sec IS NOT NULL AND TRIM(CAST(nom_sec AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')
)
