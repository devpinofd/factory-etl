config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_clientes_rechazados",
  description: "Filas de stg_clientes que no cumplen validacion de campos requeridos (cod_cli, nom_cli, status); cuarentena de calidad de datos en Silver",
  bigquery: {
    clusterBy: ["_source_empresa"]
  }
}

SELECT
  *,
  CURRENT_TIMESTAMP() AS _rechazado_en,
(
    SELECT STRING_AGG(motivo, ', ')
    FROM UNNEST([
      IF((cod_cli IS NULL OR TRIM(CAST(cod_cli AS STRING)) = ''), 'cod_cli', NULL),
      IF((nom_cli IS NULL OR TRIM(CAST(nom_cli AS STRING)) = ''), 'nom_cli', NULL),
      IF((status IS NULL OR TRIM(CAST(status AS STRING)) = ''), 'status', NULL)
    ]) AS motivo
  ) AS motivo_rechazo
FROM ${ref("stg_clientes")}
WHERE NOT (
  (cod_cli IS NOT NULL AND TRIM(CAST(cod_cli AS STRING)) != '')
  AND (nom_cli IS NOT NULL AND TRIM(CAST(nom_cli AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')
)
