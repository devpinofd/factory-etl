config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_ventas_diarias",
  description: "Tabla Silver consolidada de ventas diarias (limpia, tipada, deduplicada y particionada)",
  bigquery: {
    partitionBy: "DATE(registro)",
    clusterBy: ["source_empresa", "cod_pro", "cod_suc"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "tipo_documento", "cod_suc", "documento", "renglon"],
    nonNull: ["source_empresa", "tipo_documento", "cod_suc", "documento", "renglon", "registro"]
  }
}

WITH source_rows AS (
  SELECT
    v3.tipo_documento,
    v3.cod_suc,
    v3.documento,
    v3.renglon,
    v3.registro,
    v3.cod_ven,
    CAST(NULL AS STRING) AS nom_ven,
    v3.cod_cli,
    CAST(NULL AS STRING) AS nom_cli,
    CAST(NULL AS STRING) AS nom_cla,
    CAST(NULL AS STRING) AS nom_est,
    CAST(NULL AS STRING) AS nom_ciu,
    v3.cod_art,
    v3.cod_alm,
    CAST(NULL AS STRING) AS cod_mar,
    CAST(NULL AS STRING) AS nom_mar,
    CAST(NULL AS STRING) AS nom_dep,
    CAST(NULL AS STRING) AS cod_sec,
    CAST(NULL AS STRING) AS modelo,
    CAST(NULL AS STRING) AS cod_pro,
    CAST(NULL AS STRING) AS nom_pro,
    CAST(NULL AS STRING) AS nom_art,
    CAST(NULL AS STRING) AS cod_uni1,
    v3.can_ven,
    v3.monto_bruto,
    v3.cod_mon,
    CAST(NULL AS STRING) AS rif,
    v3.cod_imp,
    v3.por_imp1,
    v3.neto,
    v3.dcto,
    v3.tasa,
    v3.neto_dcto,
    v3._ingested_at,
    v3._source_empresa,
    v3._query_id,
    v3._query_version,
    v3._query_sql_hash,
    v3._run_id,
    v3._lote_id,
    v3._payload_hash,
    v3._row_hash,
    v3.source_empresa,
    v3.dt,
    v3.run_id,
    2 AS source_priority
  FROM ${ref("stg_ventas_diarias_v3")} v3
  UNION ALL
  SELECT
    snap.tipo_documento,
    snap.cod_suc,
    snap.documento,
    snap.renglon,
    snap.registro,
    snap.cod_ven,
    snap.nom_ven,
    snap.cod_cli,
    snap.nom_cli,
    snap.nom_cla,
    snap.nom_est,
    snap.nom_ciu,
    snap.cod_art,
    snap.cod_alm,
    snap.cod_mar,
    snap.nom_mar,
    snap.nom_dep,
    snap.cod_sec,
    snap.modelo,
    snap.cod_pro,
    snap.nom_pro,
    snap.nom_art,
    snap.cod_uni1,
    snap.can_ven,
    snap.monto_bruto,
    snap.cod_mon,
    snap.rif,
    snap.cod_imp,
    snap.por_imp1,
    snap.neto,
    snap.dcto,
    snap.tasa,
    snap.neto_dcto,
    snap._ingested_at,
    snap._source_empresa,
    snap._query_id,
    snap._query_version,
    snap._query_sql_hash,
    snap._run_id,
    snap._lote_id,
    snap._payload_hash,
    snap._row_hash,
    snap.source_empresa,
    snap.dt,
    snap.run_id,
    1 AS source_priority
  FROM ${ref("stg_ventas_diarias_snapshot")} snap
),
deduplicated AS (
  SELECT *
  FROM source_rows
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY source_empresa, tipo_documento, cod_suc, documento, SAFE_CAST(renglon AS INT64)
    ORDER BY source_priority DESC, _ingested_at DESC
  ) = 1
),
enriched AS (
  SELECT
    v.*,
    COALESCE(NULLIF(TRIM(v.cod_pro), ''), a.cod_pro) AS cod_pro_resolved
  FROM deduplicated v
  LEFT JOIN ${ref("sil_articulos")} a
    ON v.source_empresa = a.source_empresa
    AND TRIM(v.cod_art) = a.cod_art
)
SELECT
  source_empresa,
  ${helpers.trimStr("tipo_documento")} AS tipo_documento,
  ${helpers.trimStr("cod_suc")} AS cod_suc,
  ${helpers.trimStr("documento")} AS documento,
  SAFE_CAST(renglon AS INT64) AS renglon,
  ${helpers.toTimestamp("registro")} AS registro,
  DATE(${helpers.toTimestamp("registro")}) AS fecha_registro,
  ${helpers.trimStr("cod_ven")} AS cod_ven,
  ${helpers.trimStr("nom_ven")} AS nom_ven,
  ${helpers.trimStr("cod_cli")} AS cod_cli,
  ${helpers.trimStr("nom_cli")} AS nom_cli,
  ${helpers.trimStr("nom_cla")} AS nom_cla,
  ${helpers.trimStr("nom_est")} AS nom_est,
  ${helpers.trimStr("nom_ciu")} AS nom_ciu,
  ${helpers.trimStr("cod_art")} AS cod_art,
  ${helpers.trimStr("cod_alm")} AS cod_alm,
  ${helpers.trimStr("cod_mar")} AS cod_mar,
  ${helpers.trimStr("nom_mar")} AS nom_mar,
  ${helpers.trimStr("nom_dep")} AS nom_dep,
  ${helpers.trimStr("cod_sec")} AS cod_sec,
  ${helpers.trimStr("modelo")} AS modelo,
  ${helpers.trimStr("cod_pro_resolved")} AS cod_pro,
  ${helpers.trimStr("nom_pro")} AS nom_pro,
  ${helpers.trimStr("nom_art")} AS nom_art,
  ${helpers.trimStr("cod_uni1")} AS cod_uni1,
  ${helpers.toNumeric("can_ven")} AS can_ven,
  ${helpers.toNumeric("monto_bruto")} AS monto_bruto,
  ${helpers.trimStr("cod_mon")} AS cod_mon,
  ${helpers.trimStr("rif")} AS rif,  -- INCLUIDO PARA CONSUMO DE RLS
  ${helpers.trimStr("cod_imp")} AS cod_imp,
  ${helpers.toNumeric("por_imp1")} AS por_imp1,
  ${helpers.toNumeric("neto")} AS neto,
  ${helpers.toNumeric("dcto")} AS dcto,
  ${helpers.toNumeric("tasa")} AS tasa,
  ${helpers.toNumeric("neto_dcto")} AS neto_dcto,
  _ingested_at
FROM enriched
-- 🔒 Filtro de calidad: excluye filas que no cumplen campos requeridos (ver sil_*_rechazados)
WHERE
  (tipo_documento IS NOT NULL AND TRIM(CAST(tipo_documento AS STRING)) != '')
  AND (cod_suc IS NOT NULL AND TRIM(CAST(cod_suc AS STRING)) != '')
  AND (documento IS NOT NULL AND TRIM(CAST(documento AS STRING)) != '')
  AND renglon IS NOT NULL

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY source_empresa, tipo_documento, cod_suc, documento, SAFE_CAST(renglon AS INT64)
  ORDER BY _ingested_at DESC
) = 1
