config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_vendedores",
  description: "Tabla Silver de vendedores (limpia, tipada y deduplicada) generada desde stg_vendedores",
  bigquery: {
    clusterBy: ["source_empresa", "cod_ven"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "cod_ven"],
    nonNull: ["source_empresa", "cod_ven"]
  }
}

SELECT
  source_empresa,
  ${helpers.trimStr("cod_ven")} AS cod_ven,
  ${helpers.trimStr("nom_ven")} AS nom_ven,
  ${helpers.trimStr("correo")} AS correo,
  ${helpers.trimStr("cod_pai")} AS cod_pai,
  ${helpers.trimStr("cod_ciu")} AS cod_ciu,
  ${helpers.trimStr("cod_suc")} AS cod_suc,
  ${helpers.trimStr("status")} AS status,
  _ingested_at
FROM ${ref("stg_vendedores")}
-- 🔒 Filtro de calidad: excluye filas que no cumplen campos requeridos (ver sil_*_rechazados)
WHERE
  (cod_ven IS NOT NULL AND TRIM(CAST(cod_ven AS STRING)) != '')
  AND (nom_ven IS NOT NULL AND TRIM(CAST(nom_ven AS STRING)) != '')
  AND (status IS NOT NULL AND TRIM(CAST(status AS STRING)) != '')

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY source_empresa, cod_ven
  ORDER BY _ingested_at DESC
) = 1
