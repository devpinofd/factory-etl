config {
  type: "table",
  schema: "factory_etl_silver",
  name: "sil_renglones_almacenes_historico",
  description: "Histórico de snapshots de inventario por fecha de extracción. Conserva run_id para distinguir cargas repetidas del mismo día y no utiliza registro como fecha del snapshot.",
  bigquery: {
    partitionBy: "snapshot_date",
    clusterBy: ["source_empresa", "cod_alm", "cod_art"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "snapshot_date", "run_id", "cod_alm", "cod_art"],
    nonNull: ["source_empresa", "snapshot_date", "run_id", "cod_alm", "cod_art", "exi_act1"]
  }
}

SELECT
  TRIM(source_empresa) AS source_empresa,
  SAFE_CAST(DATE(_ingested_at) AS DATE) AS snapshot_date,
  TRIM(_run_id) AS run_id,
  TRIM(cod_alm) AS cod_alm,
  TRIM(cod_art) AS cod_art,
  SAFE_CAST(exi_act1 AS NUMERIC) AS exi_act1,
  SAFE_CAST(registro AS TIMESTAMP) AS registro,
  CURRENT_TIMESTAMP() AS _processed_at
FROM ${ref("stg_renglones_almacenes_snapshot")}
WHERE _ingested_at IS NOT NULL
  AND NULLIF(TRIM(source_empresa), "") IS NOT NULL
  AND NULLIF(TRIM(_run_id), "") IS NOT NULL
  AND NULLIF(TRIM(cod_alm), "") IS NOT NULL
  AND NULLIF(TRIM(cod_art), "") IS NOT NULL
  AND SAFE_CAST(exi_act1 AS NUMERIC) IS NOT NULL
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY source_empresa, SAFE_CAST(DATE(_ingested_at) AS DATE), _run_id, cod_alm, cod_art
  ORDER BY _ingested_at DESC
) = 1
