config {
  type: "table",
  disabled: dataform.projectConfig.vars.enableMondelez !== "true",
  schema: "factory_etl_gold",
  tags: ["mondelez"],
  dependOnDependencyAssertions: true,
  description: "Una ejecucion de inventario conciliada por empresa y dia Venezuela. No cambia el hecho diario legacy.",
  bigquery: {
    partitionBy: "dia_venezuela",
    clusterBy: ["source_empresa", "cod_alm", "cod_art"]
  },
  assertions: {
    uniqueKey: ["source_empresa", "dia_venezuela", "cod_alm", "cod_art"],
    nonNull: ["source_empresa", "dia_venezuela", "run_id", "captura", "cod_alm", "cod_art", "unidades_disponibles"]
  }
}

WITH ganadoras AS (
  SELECT *
  FROM ${ref("vw_inventario_capturas_qa")}
  WHERE estado = 'COMPLETA'
    AND source_empresa IN ('ctb', 'ctm', 'tinito')
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY source_empresa, dia_venezuela
    ORDER BY captura DESC, run_id DESC
  ) = 1
)
SELECT
  h.source_empresa, g.dia_venezuela, h.run_id, g.captura,
  g.batch_id, g.filas_esperadas, g.payload_hash,
  h.cod_alm, h.cod_art, h.exi_act1 AS unidades_disponibles
FROM ${ref("sil_renglones_almacenes_historico")} h
JOIN ganadoras g
  ON h.source_empresa = g.source_empresa AND h.run_id = g.run_id
