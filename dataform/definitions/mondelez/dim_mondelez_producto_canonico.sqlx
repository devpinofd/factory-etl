config {
  type: "table",
  disabled: dataform.projectConfig.vars.enableMondelez !== "true",
  schema: "factory_etl_gold",
  tags: ["mondelez"],
  description: "Maestro canonico aprobado desde Excel; clave modelo completo, pesos en kg.",
