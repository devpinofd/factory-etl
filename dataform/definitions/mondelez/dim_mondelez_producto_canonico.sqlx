    nonNull: ["modelo", "descripcion", "peso_caja_kg", "peso_unidad_kg", "unidades_por_empaque"],
    rowConditions: ["TRIM(modelo) != ''", "peso_caja_kg >= 0", "peso_unidad_kg >= 0", "unidades_por_empaque >= 0"]
  }
}

